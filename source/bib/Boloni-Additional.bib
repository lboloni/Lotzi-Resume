@inproceedings{Bhatia-2013-ICC,
   title = "Never Be Alone - Native Community Human Radar",
   author = "T.S. Bhatia and L. B{\"o}l{\"o}ni and D. Turgut",
   booktitle = "submitted to IEEE Int. Conf. on Comunications (ICC-2013)",
   year = "2013",
   bib2html_pubtype = {Conference},
   bib2html_rescat = {Wireless Networking},

   abstract = {

   This paper describes a social aware context communication framework, which
   enables new arrivals into a cosmopolitan community, to locate people of their
   own native country or ethnic group. We provide an intuitive method of
   context-aware social connections for a specific set of community based
   hurdles faced by contemporary social application. Economical and simpler
   implementation of this solution is provided using smart phone based
   application. In order to examine its extensibility, we conducted surveys and
   provided its significance in the society. All the problems associated with
   any smart phone application considered for better implementation of this
   concept.

   },
}

