@inproceedings{Rahmatizadeh-2014-Globecom,
   title = "Circular update directional virtual coordinate routing protocol for wireless sensor networks with mobile sinks",
   author = "R. Rahmatizadeh and S.A. Khan and A.P. Jayasumana and D. Turgut and L. B{\"o}l{\"o}ni",
   booktitle = "submitted to IEEE Globecom 2014",
   year = "2014",
   bib2html_pubtype = {Refereed Conference},
   bib2html_rescat = {Wireless Networking},
   abstract = {

   Virtual coordinates enables decent routing strategies without relying on geographical location of nodes in a wireless sensor network. Using a mobile sink provides advantages such as distributing energy consumption throughout the network. However, nodes need to know the updated location of the mobile sink to route to it. MS-DVCR is a routing algorithm towards a mobile sink in virtual coordinates with the basic idea of broadcasting the new location of the sink in a limited area when sink moves. In this paper, we propose CU-DVCR, a new routing strategy towards a mobile sink in virtual coordinates, which consumes less energy compared to MS-DVCR while providing comparable performance.

   }
}


