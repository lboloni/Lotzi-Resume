@inproceedings{Boloni-2013-ACS,
   title = "On the emergence of human-like cognitive dynamics in a cognitive system",
   author = "L. B{\"o}l{\"oni}",
   booktitle = "Submitted to ACS-2013",
   year = "2013",
   bib2html_pubtype = {Conference},
   bib2html_rescat = {Autonomous Agents},
   abstract = {

   Cognitive dynamics is the property of certain cognitive systems to give different results (predictions, inferences, action choices or plans) function of the presentation time of their inputs. Cognitive dynamics is not necessarily part of an abstract intelligent system: for instance, a theorem prover should always reach the same result. However, it is well known that humans do exhibit cognitive dynamics: we reach different conclusions under time pressure, when following quick events, in the presence of distractions or when contemplating problems at our leisure.

   The Xapagy cognitive architecture is a system designed to perform narrative reasoning, that is, to mimic the ways humans perceive, remember and generate stories. Although it had not been explicitly designed to model cognitive dynamics, we found that its reasoning mechanisms (shadows and headless shadows) exhibit cognitive dynamics as a side effect of their internal operations. We describe the dynamical aspects of these reasoning techniques and investigate their operation on a problem domain centered on the 1974 Soccer World Cup. We find that Xapagy exhibits similarities to the human cognitive dynamics in aspects such as bringing relevant events from the autobiography to be aligned with current events, and predicting unfolding events.

   }
}


@inproceedings{SKhan-2012-ALA,
   title = "Learning social calculus with genetic programing",
   author = "S.A. Khan and J. Streater and T. Singh Bhatia and S. Fiore and L. B{\"o}l{\"o}ni",
   booktitle = "submitted to the Adaptive Learning Agents (ALA-2012)",
   year = "2012",
   month = "June",
   location = "Valencia, Spain",
   bib2html_pubtype = {Conference},
   bib2html_rescat = {Autonomous Agents},

   abstract = {

    Physical or simulated agents sharing an environment with humans must
    evaluate the impact of their own and other agents' actions in the
    specific social and cultural context. It is desirable that this
    social calculus aligns itself with the models developed in sociology
    and psychology - however, it needs to be expressed in an
    operational, algorithmic form, suitable for implementation.

    While we can develop the framework of social calculus based on
    psychological theories of human behavior, the actual form of the
    algorithms can only be acquired from the knowledge of the specific
    culture. In this paper we show the framework for social calculus
    based on culture-sanctioned social values (CSSMs). A critical
    component of this social calculus is the set of action-impact
    functions (AIFs), which describe how the actions of the agents
    change the CSSMs in specific settings. We describe a technique to
    evolve the AIFs using genetic programming based on a limited set of
    data pairs which can be obtained by surveying humans immersed in the
    specific culture. We describe the proposed model through a scenario
    involving a group of soldiers and a robot acting on a peacekeeping
    mission.

   },
}


@inproceedings{Boloni-2012-ACS,
   title = "Shadows and headless shadows: an autobiographical approach to narrative reasoning",
   author = "L. B{\"o}l{\"o}ni",
   booktitle = "submitted to the First Annual Conference on Advances in Cognitive Systems",
   year = "2012",
   bib2html_pubtype = {Conference},
   bib2html_rescat = {Autonomous Agents},

   abstract = {

   The Xapagy architecture is a story-oriented cognitive system which
   relies exclusively on the autobiographical memory implemented as a
   raw collection of events. Reasoning is performed by shadowing current
   events with events from the autobiography. The shadows are then
   extrapolated into headless shadows (HLSs). In a story following mood,
   HLSs can be used to track the level of surprise of the agent, to
   infer hidden actions or relations between the participants, and to
   summarize ongoing events. In recall mood, the HLSs can be used to
   create new stories ranging from exact recall to free-form
   confabulation.

   },
}

