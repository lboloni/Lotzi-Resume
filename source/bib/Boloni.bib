@article{Wang-2008-AdhocNetworks,
  author           = {G. Wang and D. Turgut and L. Bölöni and Y. Ji and D.C. Marinescu},
  title            = {A {MAC} layer protocol for wireless networks with asymmetric links},
  journal          = {Ad Hoc Networks},
  volume           = {6},
