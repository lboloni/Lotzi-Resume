@inproceedings{Ai-2005-ICN,
  author           = {J. Ai and D. Turgut and L. Bölöni},
  title            = {A Cluster-based Energy Balancing Scheme in Heterogeneous Wireless Sensor Networks},
  booktitle        = {Proceedings of the 4th  International Conference on Networking ICN'05},
