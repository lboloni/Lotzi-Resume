  title            = {Agent surgery: The case for mutable agents},
  booktitle        = {Proceedings of the Third Workshop on Bio-Inspired Solutions to
                      Parallel Processing Problems (BioSP3)},
  location         = {Cancun, Mexico},
  month            = {5},
  year             = {2000},
  bib2html_pubtype = {Refereed Conference},
  bib2html_rescat  = {Autonomous Agents},
  abstract         = {We argue that mutable programs are
                      an important class of future applications. The field of
                      software agents is an important beneficiary of
                      mutability. We evaluate existing mutable applications and
                      discuss basic requirements to legitimize mutability techniques.
                      Agent surgery supports runtime mutability in the
                      agent framework of the Bond distributed object system.},
  bib2html_dl_pdf  = {http://www.cs.ucf.edu/~lboloni/Publications/Download/Boloni-2000-BioSP.pdf}
}

