@inproceedings{Kakar-2025-E3WSN,
  author           = {H. Kakar and V. S. Mohan and 
                      S. Roy and A. Dutta and O. P. Kreidl and L. Bölöni and S. Sankaran},
  author_fullname  = {Hafizullah Kakar and Vamshi S. Mohan and 
                      Swapnoneel Roy and Ayan Dutta and O. Patrick Kreidl and Ladislau Bölöni and Sriram Sankaran},
  title            = {Engineering Blockchain-Based Narrowband Internet of Things Applications for Energy Optimization},
  year             = {2025},
  month            = {12},
  booktitle        = {Proc. of the 11-th Int. Workshop on Engineering Energy Efficient InternetWorked Smart seNsors (E3WSN-2025) at AINA-2025},
  doi              = {10.1007/978-3-031-87781-0_24},
  bib2html_pubtype = {Refereed Conference},
  bib2html_rescat  = {Autonomous Agents},
  abstract         = {
                      We optimize the overall energy consumption of a Narrowband Internet of Things (NB-IoT) application created using a hybrid blockchain framework. We accomplish this by engineering the underlying hash function (SHA-256) that is used in different procedures (Unique ID generation, Device Join, and Device Transaction) of the blockchain-based NB-IoT system. In order to reduce the complexity of hash verification, IoT devices in the NB-IoT application are built to save the hashes of their authorized transactions as a linear hash chain rather than the entire Merkle tree. Furthermore, base station memory is dynamically partitioned to improve memory usage efficiency and scalability. \ignore{The Raspberry Pi 4 has been used to develop the Remix IDE framework for Ethereum. Prior to our work, the security of the framework was officially analyzed with Scyther.} Compared with the state-of-the-art approach, our approach considerably reduces the total energy consumption of the state-of-the-art application.
                      }
}

@inproceedings{Almohaimeed-2025-ICC,
  author           = {S. Almohaimeed and S. Almohaimeed and D. Turgut and L. Bölöni},
  author_fullname  = {Saad Almohaimeed and Saleh Almohaimeed and Damla Turgut and Ladislau Bölöni},
  title            = {Closest Positive Cluster Loss: Improving the Generalization of Implicit Hate Speech Classifiers Across Social Media Datasets},
  booktitle        = {Proc. of IEEE International Conference on Communications (ICC-2025)},
  year             = {2025},
  month            = {5},
  acceptance_rate  = {39\%},
  doi              = {10.1109/ICC52391.2025.11161273},
  bib2html_pubtype = {Refereed Conference},
  bib2html_rescat  = {Computer Networks},
  abstract         = {
                      Flagging hate speech on social media messages has important societal benefits. While large language models have became increasingly able to identify hate speech with high accuracy, they come with a significant computational cost. Thus, there is a need for simpler models that detect hateful or abusive content by classifying an embedding of the text. Such models perform very well for explicitly abusive content, but struggle with the classification of implicit hate. Furthermore, it has been found that the performance decreases significantly in cross-dataset experiments. In this paper, we propose Closest Positive Cluster (CPC) an auxiliary loss that increases the generalizability of embedding-based explicit and implicit hate classifiers in cross-dataset scenarios. Through experiments spanning ten different hate speech datasets, we found that the CPC loss increased the model performance by 0.17 - 7.4\% when added to the binary cross-entropy loss during training. The experiments also investigated whether models trained on specific hate speech datasets generalize better to other datasets. }
}


@inproceedings{Kulbaka-2025-3DGas,
  title            = {{GDM-Net++}: Multi-robot {2D} and {3D} Gas Distribution Mapping Via Deep {Q}-Learning and Gaussian Process Regression},
  author_fullname  = {Iliya Kulbaka and Ayan Dutta and Patrick Kreidl and Ladislau Bölöni and Swapnoneel Roy},
  author           = {I. Kulbaka and A. Dutta and P. Kreidl and L. Bölöni and S. Roy},
  year             = {2025},
  booktitle        = {Proc. of the 2025 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS 2025)},
  year             = {2025},
  month            = {10},
  xacceptance      = {46\%},
  doi              = {10.1109/IROS60139.2025.11247142},
  bib2html_pubtype = {Refereed Conference},
  bib2html_rescat  = {Autonomous Agents},
  abstract         = {
                      Gas distribution mapping (GDM) refers to the task of mapping the gas concentrations of an airborne chemical over a region of interest. A mobile robot equipped with a gas sensor can be used potentially autonomously to build such a distribution map. However, modern-day robots might not have enough battery power to cover the entire area of interest. Therefore, a group of $n$ such collaborative mobile robots can be used for this purpose. The goal of the robots is to sample concentrations from a fraction of locations and infer the gas intensities in the rest of the area using a supervised machine learning technique, namely the Gaussian Process (GP). To this end, we propose a novel multi-robot gas distribution mapping framework, named \gdm|, which works in both 2D and 3D settings. Our proposed framework first divides the environment into $n$ unique regions using Voronoi partitioning. Next, we employ a multi-agent deep Q-learning framework for the robots to learn a joint policy. As GP is a compute-intensive process, during testing, the learned policy is applied without re-training the GP model. The experiments are performed in simulation using Python on six types of Gaussian plumes to validate our proposed technique. Compared to two baselines -- greedy and random walk, \gdm| performs by $278\%$ and $852\%$ better in terms of earned rewards, while outperforming them by $34\%$ and $155\%$, respectively, in terms of the precision of gas distribution modeling across unseen 2D test cases. Our approach can also gracefully handle 2D GDM scenarios where the distribution is consistently affected by wind.                     
                      }
}

@inproceedings{Almohaimeed-2025-ImplicitHate,
  title            = {Towards Generalizable Generic Harmful Speech Datasets for Implicit Hate Speech Detection},
  author           = {S. Almohaimeed and S. Almohaimeed and D. Turgut and L. Bölöni},
  author_fullname  = {Saad Almohaimeed and Saleh Almohaimeed and Damla Turgut and Ladislau Bölöni},
  year             = {2025},
  booktitle        = {Proc. of Int. Joint Conf. on Natural Language Processing \& Asia-Pacific Chapter of the Association for Computational Linguistics (IJCNLP-AACL 2025)},
  pages            = {1582-1592},
  doi              = {10.18653/v1/2025.ijcnlp-long.85},
  acceptance_rate  = {19\%},
  bib2html_dl_pdf  = {https://aclanthology.org/2025.ijcnlp-long.85/},
  bib2html_pubtype = {Refereed Conference},
  bib2html_rescat  = {Computer Networks},
  abstract         = {
                      Implicit hate speech has recently emerged as a critical challenge for social media platforms. While much of the research has traditionally focused on harmful speech in general, the need for generalizable techniques to detect veiled and subtle forms of hate has become increasingly pressing. Based on lexicon analysis, we hypothesize that implicit hate speech is already present in publicly available harmful speech datasets but may not have been explicitly recognized or labeled by annotators. Additionally, crowdsourced datasets are prone to mislabeling due to the complexity of the task and often influenced by annotators' subjective interpretations. In this paper, we propose an approach to address the detection of implicit hate speech and enhance generalizability across diverse datasets by leveraging existing harmful speech datasets. Our method comprises three key components: influential sample identification, reannotation, and augmentation using Llama-3 70B and GPT-4o. Experimental results demonstrate the effectiveness of our approach in improving implicit hate detection, achieving a +12.9-point F1 score improvement compared to the baseline.
                      }
}

@inproceedings{Matloob-2025-Bounomodes,
  title            = {Bounomodes: the grazing ox algorithm for exploration of clustered anomalies},
  author           = {S. Matloob and A. Dutta and O. P. Kreidl and S. Roy and L. Bölöni},
  author_fullname  = {Samuel Matloob and Ayan Dutta and O. Patrick Kreidl and Swapnonel Roy and Ladislau Bölöni},
  booktitle        = {Proc. of the 24th Int. Conf. on Machine Learning and Applications (ICMLA-2025)},
  year             = {2025},
  month            = {12},
  xacceptance      = {45\%},
  doi              = {10.1109/ICMLA66185.2025.00137},
  year             = {2025},
  bib2html_dl_pdf  = {https://arxiv.org/abs/2507.06960},
  bib2html_pubtype = {Refereed Conference},
  bib2html_rescat  = {Computer Networks},
  abstract         = {
                      A common class of algorithms for informative path planning (IPP) follows boustrophedon ("as the ox turns") patterns, which aim to achieve uniform area coverage. However, IPP is often applied in scenarios where anomalies, such as plant diseases, pollution, or hurricane damage, appear in clusters. In such cases, prioritizing the exploration of anomalous regions over uniform coverage is beneficial. This work introduces a class of algorithms referred to as bounomōdes ("as the ox grazes"), which alternates between uniform boustrophedon sampling and targeted exploration of detected anomaly clusters. While uniform sampling can be designed using geometric principles, close exploration of clusters depends on the spatial distribution of anomalies and must be learned. In our implementation, the close exploration behavior is learned using deep reinforcement learning algorithms. Experimental evaluations demonstrate that the proposed approach outperforms several established baselines.
                      }
}


@article{Kakar-2026-IoT,
  title            = {Energy-Efficient Cryptographic Optimization for Narrowband {IoT} Security: Integrating Blockchain and {EP-CuMAC} with {ECM-SHA256}},
  author           = {H. Kakar and V. S. Mohan and S. Roy and A. Dutta and O. P. Kreidl and L. Bölöni and S. Sankaran},
  author_fullname  = {Hafizullah Kakar and Vamshi S. Mohan and Swapnonel Roy and Ayan Dutta and O. Patrick Kreidl and Ladislau Bölöni and Sriram Sankaran},
  journal          = {Internet of Things},
  pages            = {101828},
  year             = {2026},
  issn             = {2542-6605},
  doi              = {10.1016/j.iot.2025.101828},
  bib2html_dl_pdf  = {https://www.sciencedirect.com/science/article/pii/S2542660525003427},
  bib2html_pubtype = {Journal},
  bib2html_rescat  = {Computer Networks},
  impact_factor    = {7.6},
  abstract         = {
                      Narrowband Internet of Things (NB-IoT) continues to expand but faces challenges of cryptographic overhead and energy consumption. Security frameworks such as blockchain and Energy-Performance Cumulative Message Authentication Codes (EP-CuMAC) rely heavily on SHA-256, which is not optimized for energy-limited devices. This work unifies two complementary approaches—a hybrid blockchain-based NB-IoT framework and an EP-CuMAC-based framework—by engineering their cryptographic core with an Energy Complexity Model-optimized SHA-256 (ECM-SHA256). ECM applies parallel memory-bank mapping and block-level access optimization to reduce redundant power usage while preserving algorithmic integrity. Experimental evaluation on identical Intel DDR3 systems using pyRAPL shows energy savings of 2–13\% across blockchain (Unique ID Generation, Device Join, Transactions) and EP-CuMAC modules (Feedback, Prediction, Verification, Retransmission). The optimization leverages the Energy Complexity Model’s parallel memory-bank mapping of SHA-256, implemented on identical Intel DDR3 systems using pyRAPL for repeatable measurements. The results position ECM-SHA256 as a generalizable cryptographic optimization strategy for secure and sustainable NB-IoT deployments.
                      }
}


@inproceedings{Kulbaka-2026-TinyIsMighty,
  title              = {Tiny is Mighty Enough: Evaluating Tiny and Large Language Models for Controlling Autonomous Agents},
  author             = {I. Kulbaka and A. Dutta and O. P. Kreidl and L. Bölöni and S. Roy},
  author_fullname    = {Iliya Kulbaka and Ayan Dutta and O. Patrick Kreidl and Ladislau Bölöni and Swapnoneel Roy},
  booktitle          = {to be published in the Proc. of the IEEE CAI 2026
                        IEEE Conference on Artificial Intelligence 2026 (CAI-2026)},
  year               = {2026},
  month              = {05},
  xacceptance        = {??\%},
  xxxbib2html_dl_pdf = {https://arxiv.org/abs/2507.06960},
  bib2html_pubtype   = {Refereed Conference},
  bib2html_rescat    = {Autonomous Agents},
  abstract           = {
                        In recent years, the invention and relatively easy access to large language models have taken the scientific world by storm. These models typically have billions of parameters and require a substantial amount of computational and energy overhead. In this paper, we investigate how the smaller models, called Tiny Language Models (TLMs), with a parameter size of a few billion, stack up against their larger counterparts for controlling autonomous agents (e.g., a robot arm). More specifically, our proposed evaluation framework has three main components: user prompts (e.g., go right), an interpreter to process the prompt to map it to pre-defined functions, and finally, a test block to test the called function on the agent. We have tested the proposed framework on six different OpenAI Gym environments, where we created up to seven tasks for the autonomous agent to perform. We also introduced a novel performance metric, named Billion Parameter Normalized Score (BiPaNS), to evaluate the performance of language models of various complexities. Results show that although tiny in size, TLMs performed comparably against large models while outperforming them when the parameter size was considered as an evaluation metric using BiPaNS.                      
                        }
}

@article{AIReview-2026-GreenerRL,
  author             = {J. Gardner and A. Dutta and S. Roy and O. P. Kreidl and L. Bölöni},
  author_fullname    = {Jason Gardner and Ayan Dutta and Swapnoneel Roy and O. Patrick Kreidl and Ladislau B\"ol\"oni},
  number             = {148},
  title              = {Greener Deep Reinforcement Learning: Analysis of Energy and Carbon Efficiency Across {A}tari Benchmarks},
  volume             = {59},
  year               = {2026},
  journal            = {Artificial Intelligence Review (Springer Nature)},
  bib2html_pubtype   = {Journal},
  bib2html_rescat    = {Autonomous Agents},
  bib2html_dl_pdf = {https://link.springer.com/article/10.1007/s10462-026-11520-x},
  impact_factor      = {13.9},
  doi = {10.1007/s10462-026-11520-x},
  abstract           = {Deep reinforcement learning (DRL) has achieved remarkable performance across a wide range of tasks, yet its growing computational demands raise significant environmental and economic concerns. While prior work has largely emphasized learning performance and sample efficiency, the energy consumption, carbon emissions, and monetary cost of DRL training remain poorly understood. In this work, we present a systematic energy benchmarking study of seven widely used DRL algorithms, i.e., DQN, TRPO, A2C, ARS, PPO, RecurrentPPO, and QR-DQN, evaluated on ten Atari 2600 benchmarks under identical hardware and software configurations. Each algorithm is trained for one million steps, with real-time power measurements used to estimate total energy usage, CO$_2$-equivalent emissions, and electricity cost. Our results over ten runs reveal substantial disparities in energy efficiency across algorithms: derivative-free methods such as ARS achieve comparable performance to DQN while consuming approximately 77\% less energy. In contrast, distributional and recurrent approaches incur substantially higher environmental and monetary overheads: for example, RecurrentPPO produces over 1,344\% more CO$_2$ emissions and incurs more than 1,367\% higher national monetary cost than the most energy-efficient alternative (ARS), while QR-DQN exhibits moderately higher emissions relative to DQN. These findings demonstrate that algorithmic choice alone can induce multi-fold differences in energy efficiency without sacrificing performance, highlighting the importance of incorporating energy and sustainability metrics into the evaluation and design of future DRL systems.}
}

@inproceedings{Sheikholeslami-2026-VisProprio,
  title            = {Latent Representations for Visual Proprioception in Inexpensive Robots},
  author           = {S. Sheikholeslami and L. Bölöni},
  author_fullname  = {Sahara Sheikholeslami and Ladislau Bölöni},
  year             = {2026},
  booktitle        = {Proc. of Int. Conf. on Robotics and Automation (ICRA-2026)},
  year             = {2026},
  bib2html_dl_pdf  = {https://arxiv.org/abs/2504.14634},
  bib2html_pubtype = {Refereed Conference},
  bib2html_rescat  = {Autonomous Agents},
  abstract         = {
                      Robotic manipulation requires explicit or implicit knowledge of the robot's joint positions. Precise proprioception is standard in high-quality industrial robots but is often unavailable in inexpensive robots operating in unstructured environments. In this paper, we ask: to what extent can a fast, single-pass regression architecture perform visual proprioception from a single external camera image, available even in the simplest manipulation settings? We explore several latent representations, including CNNs, VAEs, ViTs, and bags of uncalibrated fiducial markers, using fine-tuning techniques adapted to the limited data available. We evaluate the achievable accuracy through experiments on an inexpensive 6-DoF robot.
                      }
}

@inproceedings{Bilic-2026-ASAB,
  title            = {Behavior Cloning for Active Perception with Low-Resolution Egocentric Vision},
  author           = {A. Bilic and C. Chen and L. Bölöni},
  author_fullname  = {Anthony Bilic and Chen Chen and Ladislau Bölöni},
  year             = {2026},
  booktitle        = {Proc. of Act to Sense to Act Better Workshop (ASAB-2026) at ICRA-2026},
  year             = {2026},
  bib2html_pubtype = {Refereed Conference},
  bib2html_rescat  = {Autonomous Agents},
  abstract         = {
                      We investigate whether behavior cloning is sufficient to produce active perception in a structured object-finding task. A low-cost robot arm equipped with a wrist-mounted egocentric RGB camera must reposition to center a partially visible plant before triggering a grasp signal, requiring actions that improve future observations. The model predicts joint commands directly from low-resolution RGB images under closed-loop control. We show that low-resolution egocentric vision is sufficient for reliable task completion and that predicting relative joint deltas substantially outperforms absolute joint position prediction in our setting. These results demonstrate that visually grounded active perception can emerge from behavior cloning in a reproducible setting.
                      }
}

@inproceedings{Konievic-2026-MMSpatial,
  title            = {Generalizing Visual Proprioception for Multiple Robot Configurations},
  author           = {R. A. Konievic and S. Sheikholeslami and L. Bölöni and L. Tamas},
  author_fullname  = {Robert-Anton Konievic and Sahara Sheikholeslami and Ladislau Bölöni and Levente Tamas},
  year             = {2026},
  booktitle        = {Proc. of Multi-Modal Spatial AI for Robust Navigation and Open-World Understanding (MM-SpatialAI) Workshop at ICRA-2026},
  bib2html_pubtype = {Refereed Conference},
  bib2html_rescat  = {Autonomous Agents},
  abstract         = {
                      Future robotic systems will likely consist of a wide variety of robot embodiments, operating in unpredictable environments, with compliant joints and casual use of tools for which no precise models are available. Visual proprioception is a promising approach that can complement the limited internal proprioception capabilities of such robots. However, a key question is how generalizable visual proprioception is across different embodiments. In this work we investigate the generalization of visual proprioception across three very different robot configurations: a low-cost and low-precision 6DOF AL5D arm, a high precision 7DOF Franka arm, and a humanoid G1 arm with 7DOF. We investigate whether the same proprioception model architecture can be used with different robots with minimal changes (e.g. changing the output size of the regression model). Furthermore, we investigate whether parts of actual model, such as the pretrained vision encoder can be reused across different robots.
                      
                      }
}

@inproceedings{Danielpour-2026-ISPN,
  title            = {Vision {AI}-generated Volumetric Brain-to-Ventricle Ratio as a Superior Biomarker for Symptomatic Hydrocephalus in Achondroplasia: Beyond Head Circumference},
  author           = {M. Danielpour and S. Sheikholeslami and L. Bölöni},
  author_fullname  = {Moise Danielpour and Sahara Sheikholeslami and Ladislau Bölöni},
  year             = {2026},
  month            = {10},
  booktitle        = {Proc. of Annual Meeting of the International Society for Pediatric Neurosurgery (ISPN-2026)},
  bib2html_pubtype = {Refereed Conference},
  bib2html_rescat  = {Autonomous Agents},
  abstract         = {
    Macrocephaly is a hallmark of achondroplasia, often resulting from a small cranial base and compensated ventriculomegaly rather than active hydrocephalus. Furthermore, children with achondroplasia are at risk for both communicating and obstructive hydrocephalus. Standard screening relies on head circumference (HC), yet the distorted calvarial growth in achondroplasia limits HC's specificity as a surrogate for intracranial pressure. The care of these children is further complicated as there are no clear guidelines on which children require imaging and how to interpret the images once they are obtained. This study aims to evaluate whether the ratio of total ventricular volume (VV) to total brain volume (TBV) can accurately differentiate between communicating/obstructive symptomatic hydrocephalus requiring surgical intervention from benign phenotypic macrocephaly.
}
} 
     