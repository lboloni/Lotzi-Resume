\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lotzicv}[2026/10/15 Lotzi Boloni CV layout]

%----------------------------------------------------------------------------------------
%	FONT
%----------------------------------------------------------------------------------------

% fontspec allows you to use TTF/OTF fonts directly
\RequirePackage{fontspec}

%------------------------------------------------------------------------------
%	PACKAGES
%------------------------------------------------------------------------------
\RequirePackage{url}
\RequirePackage{parskip}

%other packages for formatting
\RequirePackage{color}
\RequirePackage{graphicx}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage[scale=0.9]{geometry}

%tabularx environment
\RequirePackage{tabularx}

%for lists within experience section
\RequirePackage{enumitem}
% don't use, as clashes \usepackage{paralist}

% centered version of 'X' col. type
\newcolumntype{C}{>{\centering\arraybackslash}X}

%to prevent spillover of tabular into next pages
\RequirePackage{supertabular}
\newlength{\fullcollw}
\setlength{\fullcollw}{0.47\textwidth}

%custom \section
\RequirePackage{titlesec}
\RequirePackage{multicol}
\RequirePackage{multirow}

%CV Sections inspired by:
%http://stefano.italians.nl/archives/26
\titleformat{\section}{\Large\scshape\raggedright}{}{0em}{}[\titlerule]
\titlespacing{\section}{0pt}{10pt}{10pt}

%for publications
\RequirePackage[style=ieee,maxnames=100,isbn=false]{biblatex}
% Boloni.bib is shared with the webpage, whose award notes are HTML
% (note = {<b>Best Paper Award</b>}). Print them in bold instead of as tags.
% The < and > are written as \x3C and \x3E: the regexp goes into the XML .bcf file.
\DeclareSourcemap{
  \maps[datatype=bibtex]{
    \map{
      \step[fieldsource=note, match=\regexp{\x3Cb\x3E(.*?)\x3C/b\x3E}, replace=\regexp{\\textbf\{$1\}}]
    }
  }
}

%Setup hyperref package, and colours for links
\RequirePackage[unicode, draft=false]{hyperref}
\definecolor{linkcolour}{rgb}{0,0.2,0.6}
\hypersetup{colorlinks,breaklinks,urlcolor=linkcolour,linkcolor=linkcolour}

%for social icons
\RequirePackage{fontawesome5}

%------------------------------------------------------------------------------
%	VARIANT SWITCHES
%------------------------------------------------------------------------------
% \withfundingtrue prints the Research Grants section (CV-LotziBoloni_WithFunding).
\newif\ifwithfunding
\withfundingfalse
% \toconfirm marks a drafted item that Lotzi still has to check (red in the PDF).
\newcommand{\toconfirm}{\textcolor{red}{[to confirm]}}

\endinput
